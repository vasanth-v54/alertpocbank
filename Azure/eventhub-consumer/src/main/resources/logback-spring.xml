<configuration>

    <!-- Base log directory -->
    <property name="LOG_PATH" value="logs"/>

    <!-- ========================= -->
    <!-- APP LOG (Hourly Rolling) -->
    <!-- ========================= -->
    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/app/app.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Hourly rotation -->
            <fileNamePattern>${LOG_PATH}/app/app-%d{yyyy-MM-dd_HH}.log</fileNamePattern>
            <maxHistory>7</maxHistory> <!-- keep 7 days -->
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ========================= -->
    <!-- AUDIT LOG (Separate File) -->
    <!-- ========================= -->
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/audit/audit.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Daily rotation (you can make hourly if needed) -->
            <fileNamePattern>${LOG_PATH}/audit/audit-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [AUDIT] %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ========================= -->
    <!-- AUDIT LOGGER -->
    <!-- ========================= -->
    <logger name="AUDIT_LOGGER" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_FILE"/>
    </logger>

    <!-- ========================= -->
    <!-- ROOT LOGGER -->
    <!-- ========================= -->
    <root level="INFO">
        <appender-ref ref="APP_FILE"/>
    </root>

</configuration>