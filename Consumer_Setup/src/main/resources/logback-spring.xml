<configuration>

    <property name="LOG_PATH" value="logs"/>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- ============================= -->
    <!-- Main Consumer Log -->
    <!-- ============================= -->

    <appender name="CONSUMER_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/consumer.log</file>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_PATH}/consumer-%d{yyyy-MM-dd_HH-mm}.%i.log
            </fileNamePattern>

            <maxFileSize>5MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>

        </rollingPolicy>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

    </appender>

    <!-- ============================= -->
    <!-- Error Log -->
    <!-- ============================= -->

    <appender name="ERROR_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/consumer-error.log</file>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_PATH}/consumer-error-%d{yyyy-MM-dd}.%i.log
            </fileNamePattern>

            <maxFileSize>5MB</maxFileSize>
            <maxHistory>30</maxHistory>

        </rollingPolicy>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

        <!-- Only ERROR logs -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>

    </appender>

    <!-- ============================= -->
    <!-- Audit Log -->
    <!-- ============================= -->

    <appender name="AUDIT_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/consumer-audit.log</file>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_PATH}/consumer-audit-%d{yyyy-MM-dd}.%i.log
            </fileNamePattern>

            <maxFileSize>5MB</maxFileSize>
            <maxHistory>30</maxHistory>

        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} | %msg%n</pattern>
        </encoder>

    </appender>


    <!-- ============================= -->
    <!-- Template Processing Log -->
    <!-- ============================= -->

    <appender name="TEMPLATE_PROCESS_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/template-process.log</file>

        <rollingPolicy
                class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_PATH}/template-process-%d{yyyy-MM-dd}.%i.log
            </fileNamePattern>

            <maxFileSize>5MB</maxFileSize>
            <maxHistory>30</maxHistory>

        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} | %msg%n</pattern>
        </encoder>

    </appender>


    <!-- ============================= -->
    <!-- Console -->
    <!-- ============================= -->

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>

    </appender>


    <!-- ============================= -->
    <!-- Audit Logger -->
    <!-- ============================= -->

    <logger name="CONSUMER_AUDIT_LOGGER"
            level="INFO"
            additivity="false">

        <appender-ref ref="AUDIT_FILE"/>

    </logger>


    <!-- ============================= -->
    <!-- Template Process Logger -->
    <!-- ============================= -->

    <logger name="TEMPLATE_PROCESS_LOGGER"
            level="INFO"
            additivity="false">

        <appender-ref ref="TEMPLATE_PROCESS_FILE"/>

    </logger>


    <!-- ============================= -->
    <!-- Root Logger -->
    <!-- ============================= -->

    <root level="INFO">

        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="CONSUMER_FILE"/>
        <appender-ref ref="ERROR_FILE"/>

    </root>

</configuration>